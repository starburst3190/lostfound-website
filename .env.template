# Supabase Configuration
SUPABASE_URL=https://xxxx.supabase.co
DATABASE_URL= # Usually starts with postgresql://
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET= # Optional, can be left empty

# Flask Secret Key
SECRET_KEY=generate_a_random_secret_key_here

# Jina embeddings v3 (fallback to keyword matching if left empty)
# Get API key at https://jina.ai/embeddings/
JINA_API_KEY=jina_xxxx

# SMTP Configuration for Matching Emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=EMAIL_ADDRESS
SMTP_PASSWORD=
SMTP_SENDER=NAME <EMAIL_ADDRESS>